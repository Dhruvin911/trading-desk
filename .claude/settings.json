{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "mcp__.*__(place_equity_order|place_option_order|place_crypto_order|exercise_option)",
        "hooks": [
          {"type": "command", "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/order_guard.py\""}
        ]
      },
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {"type": "command", "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/write_guard.py\""}
        ]
      }
    ]
  }
}
